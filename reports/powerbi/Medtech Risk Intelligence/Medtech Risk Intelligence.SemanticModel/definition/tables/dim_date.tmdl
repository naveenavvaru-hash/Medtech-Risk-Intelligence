		lineageTag: ea3869fd-551f-5283-9c63-1c8e5883b528
		summarizeBy: none
		sourceColumn: month

		annotation SummarizationSetBy = User

	column month_name
		dataType: string
		lineageTag: 8978ccd4-d8f0-5a6d-9754-cf4078d028ca
		summarizeBy: none
		sourceColumn: month_name
		sortByColumn: month

	column week
