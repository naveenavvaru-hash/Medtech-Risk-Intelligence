	column date_key
		dataType: int64
		isHidden
		lineageTag: 1f1b511a-787a-5509-8533-907f993784ac
		summarizeBy: none
		sourceColumn: date_key

	column full_date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		lineageTag: 0f2fd9cb-52b9-5b7b-888e-ebcb12185210
		summarizeBy: none
		sourceColumn: full_date

