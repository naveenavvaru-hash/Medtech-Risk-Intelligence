		sourceColumn: [Is Watch]

		annotation SummarizationSetBy = User

	partition ctl_CategoryMonth = calculated
		mode: import
		source =
				
				VAR Ev =
				    ADDCOLUMNS (
				        SELECTCOLUMNS (
				            fact_events,
				            "dk", fact_events[date_key],
				            "Category", RELATED ( dim_device[category] )
				        ),
				        "Year", INT ( [dk] / 10000 ),
				        "Month", MOD ( INT ( [dk] / 100 ), 100 )
				    )
				VAR Keys =
				    DISTINCT (
				        SELECTCOLUMNS ( Ev, "Category", [Category], "Year", [Year], "Month", [Month] )
				    )
				VAR Base =
				    ADDCOLUMNS (
				        Keys,
				        "Events",
				            VAR c = [Category]
				            VAR y = [Year]
				            VAR m = [Month]
				            RETURN
				                COUNTROWS ( FILTER ( Ev, [Category] = c && [Year] = y && [Month] = m ) ),
				        "MonthIdx", [Year] * 12 + [Month] - 1
				    )
				VAR S1 =
				    ADDCOLUMNS (
				        Base,
				        "Prior Months",
				            VAR c = [Category]
				            VAR i = [MonthIdx]
				            RETURN
				                COUNTROWS ( FILTER ( Base, [Category] = c && [MonthIdx] < i && [MonthIdx] >= i - 12 ) ),
				        "Rolling Mean",
				            VAR c = [Category]
				            VAR i = [MonthIdx]
				            RETURN
				                AVERAGEX ( FILTER ( Base, [Category] = c && [MonthIdx] < i && [MonthIdx] >= i - 12 ), [Events] ),
				        "Rolling SD",
				            VAR c = [Category]
				            VAR i = [MonthIdx]
				            VAR T = FILTER ( Base, [Category] = c && [MonthIdx] < i && [MonthIdx] >= i - 12 )
				            RETURN
				                IF ( COUNTROWS ( T ) >= 2, STDEVX.S ( T, [Events] ) )
				    )
				VAR S2 =
				    ADDCOLUMNS (
				        S1,
				        "UCL", IF ( NOT ISBLANK ( [Rolling SD] ), [Rolling Mean] + 3 * [Rolling SD] ),
				        "Z Score", IF ( [Prior Months] >= 6 && [Rolling SD] > 0, DIVIDE ( [Events] - [Rolling Mean], [Rolling SD] ) ),
				        "Month Start", DATE ( [Year], [Month], 1 )
				    )
				RETURN
				    ADDCOLUMNS (
				        S2,
				        "Status",
				            SWITCH (
				                TRUE (),
				                [Prior Months] < 6, "Not enough history",
				                [Events] > [UCL], "Breach",
				                [Z Score] >= 2, "Watch",
				                "Normal"
				            ),
				        "Is Breach", IF ( [Prior Months] >= 6 && [Events] > [UCL], 1, 0 ),
				        "Is Watch", IF ( [Prior Months] >= 6 && NOT ( [Events] > [UCL] ) && [Z Score] >= 2, 1, 0 )
				    )

	annotation PBI_Id = e0fb59c3d4184767bd3131a5f2bd49ff

